; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are defined by the engine's own code.

config_version=5

[application]

config/name="Gathering Frontier"
config/description="横スクロール素材採集ゲーム。家・店・出店・クラフト・仲間キャラクター搭載。"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
ItemDB="*res://scripts/autoload/ItemDB.gd"
RecipeDB="*res://scripts/autoload/RecipeDB.gd"
Inventory="*res://scripts/autoload/Inventory.gd"
Equipment="*res://scripts/autoload/Equipment.gd"
GameState="*res://scripts/autoload/GameState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

