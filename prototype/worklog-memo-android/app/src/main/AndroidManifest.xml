<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 「ドライブで同期」をオンにしたときだけ、利用者の Google ドライブ(アプリ専用の隠しフォルダ)と通信する -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ほかのアプリの使用時間を読む(端末の設定画面で「使用状況へのアクセス」を許可する) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- 集中中に、指定したアプリの上を覆う(「他のアプリの上に重ねて表示」を許可する) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 再起動のあと、ロック画面のタイマーの通知を出し直す -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 予定やポモドーロの知らせを遅れずに届ける(「アラームとリマインダー」を許可する。なくても少し遅れて届く) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 端末に入っているアプリ(ホーム画面に出るもの)の一覧を読む -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ホーム画面のウィジェット:ストップウォッチ/タイマーを始める・止める -->
        <receiver
            android:name=".TimerWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timer_widget_info" />
        </receiver>

        <!-- ロック画面の通知のボタンと、再起動・更新のあとの出し直し -->
        <receiver
            android:name=".TimerNoticeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 予定・ポモドーロの区切り・止め忘れの知らせ -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <service
            android:name=".UsageOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="利用者が選んだアプリの使用中、その日の使用時間を画面の隅に表示する(設定でオンにしたときのみ)" />
        </service>

        <service
            android:name=".BlockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="集中タイマー中、利用者が指定したアプリが前面に出たら画面を覆う(試験運用・最大5分)" />
        </service>
    </application>
</manifest>
